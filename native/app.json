{
  "expo": {
    "name": "Rituel",
    "slug": "rituel",
    "version": "3.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rituel",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0F1216",
    "ios": {
      "bundleIdentifier": "fr.rituel.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Rituel",
        "CFBundleDevelopmentRegion": "fr",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "fr.rituel.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F1216",
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "permissions": ["VIBRATE", "POST_NOTIFICATIONS", "WAKE_LOCK"]
    },
    "plugins": [
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "resizeMode": "contain", "backgroundColor": "#0F1216", "dark": { "backgroundColor": "#0B0D10" } }],
      ["expo-notifications", { "icon": "./assets/adaptive-monochrome.png", "color": "#D8382B", "defaultChannel": "rituel" }]
    ],
    "extra": {
      "webUrl": "https://rituel-6b365.web.app",
      "eas": {}
    }
  }
}
